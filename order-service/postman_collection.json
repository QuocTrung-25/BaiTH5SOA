{
  "info": {
    "name": "Bai Thuc Hanh 4 - Order Service (SOA)",
    "description": "Postman Collection kiểm thử đầy đủ API Bài Thực Hành 4 - Dịch vụ Quản lý Đơn hàng (Order Management)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "auth_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "product_url",
      "value": "http://localhost:8081"
    },
    {
      "key": "order_url",
      "value": "http://localhost:8082"
    },
    {
      "key": "jwt_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Đăng nhập (Auth Service :8080)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('jwt_token', jsonData.token);",
              "    console.log('JWT Token saved:', jsonData.token);",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"MTIzNDU2\"\n}"
        },
        "url": {
          "raw": "{{auth_url}}/api/v1/auth/login",
          "host": ["{{auth_url}}"],
          "path": ["api", "v1", "auth", "login"]
        }
      }
    },
    {
      "name": "1. GET /orders - Danh sách đơn hàng",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{order_url}}/orders",
          "host": ["{{order_url}}"],
          "path": ["orders"]
        }
      }
    },
    {
      "name": "2. GET /orders/:id - Chi tiết một đơn hàng",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{order_url}}/orders/1",
          "host": ["{{order_url}}"],
          "path": ["orders", "1"]
        }
      }
    },
    {
      "name": "3. POST /orders - Tạo đơn hàng mới (Kiểm tra tồn kho)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_name\": \"Nguyễn Văn A\",\n  \"customer_email\": \"nguyenvana@gmail.com\",\n  \"status\": \"pending\",\n  \"items\": [\n    {\n      \"product_id\": 1,\n      \"quantity\": 2\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{order_url}}/orders",
          "host": ["{{order_url}}"],
          "path": ["orders"]
        }
      }
    },
    {
      "name": "4. PUT /orders/:id - Cập nhật trạng thái đơn hàng",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\"\n}"
        },
        "url": {
          "raw": "{{order_url}}/orders/1",
          "host": ["{{order_url}}"],
          "path": ["orders", "1"]
        }
      }
    },
    {
      "name": "5. DELETE /orders/:id - Xóa đơn hàng",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{order_url}}/orders/1",
          "host": ["{{order_url}}"],
          "path": ["orders", "1"]
        }
      }
    },
    {
      "name": "6. GET /order_items - Danh sách tất cả mặt hàng",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{order_url}}/order_items",
          "host": ["{{order_url}}"],
          "path": ["order_items"]
        }
      }
    },
    {
      "name": "7. GET /order_items/:id - Chi tiết một mặt hàng",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{order_url}}/order_items/1",
          "host": ["{{order_url}}"],
          "path": ["order_items", "1"]
        }
      }
    },
    {
      "name": "8. POST /order_items - Tạo mặt hàng mới",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_id\": 1,\n  \"product_id\": 1,\n  \"quantity\": 2\n}"
        },
        "url": {
          "raw": "{{order_url}}/order_items",
          "host": ["{{order_url}}"],
          "path": ["order_items"]
        }
      }
    },
    {
      "name": "9. PUT /order_items/:id - Cập nhật mặt hàng",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quantity\": 4\n}"
        },
        "url": {
          "raw": "{{order_url}}/order_items/1",
          "host": ["{{order_url}}"],
          "path": ["order_items", "1"]
        }
      }
    },
    {
      "name": "10. DELETE /order_items/:id - Xóa một mặt hàng",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{jwt_token}}" }
        ],
        "url": {
          "raw": "{{order_url}}/order_items/1",
          "host": ["{{order_url}}"],
          "path": ["order_items", "1"]
        }
      }
    }
  ]
}
